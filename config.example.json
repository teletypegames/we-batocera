    "api": {
      "catalog": "/api/software",
      "download": "/api/download"
    }
  },
  "paths": {
    "roms_root": "/userdata/roms",
    "subfolder": "example"
  },
  "emulationstation": {
    "menu": {
      "mode": "system",
      "name": null,
      "theme": null,
      "logo": null,
      "updater": true,
      "labels": {}
    },
    "ports_entry": null,
    "folder_name": "Example Store",
    "restart": true,
    "config_dir": null
  },
  "catalog": {
    "statuses": [
      "released",
      "archived"
    ],
    "owner_id": null,
    "only": [],
    "exclude": []
  },
  "platforms": {
    "c64": {
      "system": "c64",
      "kind": "package",
      "ext": "",
      "enabled": true
    },
    "plus4": {
      "system": "cplus4",
      "kind": "package",
      "ext": "",
      "enabled": true
    },
    "tic80": {
      "system": "tic80",
      "kind": "package",
      "ext": ".tic",
      "enabled": true
    },
    "bevy": {
